 /* A convenience routine for use by other parts of the shell to execute
    a particular shell function. */
+/* Recompute exit_immediately_on_error once builtin_ignoring_errexit has been
+   restored, honoring any `set -e' or `set +e' run in the meantime. */
+static void
+uw_restore_errexit (void *ignore)
+{
+  exit_immediately_on_error = builtin_ignoring_errexit ? 0 : errexit_flag;
+}
+
+/* Commands the shell runs on its own behalf -- PROMPT_COMMAND, traps, `bind
+   -x' key bindings and completion functions -- ignore errexit in interactive
+   shells as if they were run as `command || true'. Otherwise a failing hook
+   would abort every command the user types, or in the case of
+   PROMPT_COMMAND, loop forever without reading input. The caller must have
+   begun an unwind frame; running it restores the previous settings. */
+void
+ignore_errexit_in_hook (void)
+{
+  if (ERREXIT_RETURNS_TO_PROMPT () == 0)
+    return;
+  add_unwind_protect (uw_restore_errexit, NULL);
+  unwind_protect_int (builtin_ignoring_errexit);
+  builtin_ignoring_errexit = 1;
+  exit_immediately_on_error = 0;
+}
