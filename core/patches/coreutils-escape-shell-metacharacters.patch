Add support for a new "--quoting-style" value, "escape-shell-metacharacters",
which will backslash-escape shell metacharacters.

--- lib/quotearg.c	2026-06-16 07:14:38.000000000 -0500
+++ lib/quotearg.c	2026-10-28 03:47:02.009109642 -0500
@@ -105,6 +105,7 @@
   "escape",
   "locale",
   "clocale",
+  "escape-shell-metacharacters",
   NULL
 };
 
--- src/ls.c	2026-09-13 21:05:25.000000000 -0500
+++ src/ls.c	2026-10-28 03:48:00.069576270 -0500
